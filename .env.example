# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API Key for AI Copilot features
GEMINI_API_KEY=""

# Typesense Search Engine Configuration
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/keklapis?schema=public"

# NextAuth / Auth.js Configuration (OAuth & Secrets)
AUTH_SECRET="run-npx-auth-secret-to-generate-a-secure-random-string"
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"